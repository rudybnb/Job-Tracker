# Job Tracker production configuration example.
# Use real values only in the deployment secret store or untracked environment files.

DATABASE_URL=postgresql://user:password@host:5432/job_tracker
SESSION_SECRET=<REPLACE_WITH_LONG_RANDOM_SESSION_SECRET>

# Meta WhatsApp Cloud API outbound provider.
# If WHATSAPP_ACCESS_TOKEN or WHATSAPP_PHONE_NUMBER_ID is missing, live sends stay disabled.
WHATSAPP_ACCESS_TOKEN=<REDACTED_WHATSAPP_ACCESS_TOKEN>
WHATSAPP_PHONE_NUMBER_ID=<REDACTED_WHATSAPP_PHONE_NUMBER_ID>

# Meta WhatsApp webhook verification and signature validation.
# Missing values cause webhook verification/signature checks to fail closed.
WHATSAPP_VERIFY_TOKEN=<REDACTED_WHATSAPP_VERIFY_TOKEN>
WHATSAPP_APP_SECRET=<REDACTED_WHATSAPP_APP_SECRET>
